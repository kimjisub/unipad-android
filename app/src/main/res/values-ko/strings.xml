    <string name="midi_status_connected">연결됨: %1$s</string>
    <string name="midi_status_unknown_detail">기종을 알아보지 못해 건반 방식으로 연결했어요. 런치패드라면 \'연결이 안 되나요?\'를 눌러 주세요.</string>
