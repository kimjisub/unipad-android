<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service android:name="com.kimjisub.launchpad.midi.MidiFixtureService"
            android:permission="android.permission.BIND_MIDI_DEVICE_SERVICE"
            android:exported="true" android:process=":midiFixture">
            <intent-filter><action android:name="android.media.midi.MidiDeviceService" /></intent-filter>
            <meta-data android:name="android.media.midi.MidiDeviceService" android:resource="@xml/midi_fixture" />
        </service>
        <service android:name="com.kimjisub.launchpad.midi.UnselectedMidiFixtureService"
            android:permission="android.permission.BIND_MIDI_DEVICE_SERVICE"
            android:exported="true" android:process=":otherMidiFixture">
            <intent-filter><action android:name="android.media.midi.MidiDeviceService" /></intent-filter>
            <meta-data android:name="android.media.midi.MidiDeviceService" android:resource="@xml/midi_fixture" />
        </service>
        <provider android:name="com.kimjisub.launchpad.midi.MidiFixtureProvider"
            android:authorities="com.kimjisub.launchpad.dev.test.midi" android:exported="true"
            android:process=":midiFixture" />
        <provider android:name="com.kimjisub.launchpad.midi.OtherMidiFixtureProvider"
            android:authorities="com.kimjisub.launchpad.dev.test.othermidi" android:exported="true"
            android:process=":otherMidiFixture" />
        <service android:name="com.kimjisub.launchpad.midi.InputOnlyMidiFixtureService"
            android:permission="android.permission.BIND_MIDI_DEVICE_SERVICE"
            android:exported="true" android:process=":inputOnlyMidiFixture">
            <intent-filter><action android:name="android.media.midi.MidiDeviceService" /></intent-filter>
            <meta-data android:name="android.media.midi.MidiDeviceService" android:resource="@xml/midi_input_only_fixture" />
        </service>
        <provider android:name="com.kimjisub.launchpad.midi.InputOnlyMidiFixtureProvider"
            android:authorities="com.kimjisub.launchpad.dev.test.inputmidi" android:exported="true"
            android:process=":inputOnlyMidiFixture" />
    </application>
    <queries>
        <package android:name="com.kimjisub.launchpad.dev" />
    </queries>
    <!-- Gradle applies its runner overrides to the first instrumentation element. -->
    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="com.kimjisub.launchpad.dev" />
    <!-- A preparation probe, separate from JUnit discovery and the test suites. -->
    <instrumentation
        android:name="com.kimjisub.launchpad.DeviceSettingsProbe"
        android:targetPackage="com.kimjisub.launchpad.dev" />
    <instrumentation
        android:name="com.kimjisub.launchpad.ProcessRecoverySetup"
        android:targetPackage="com.kimjisub.launchpad.dev" />
    <!-- Self-targeted: this driver survives the target app's process death. -->
    <instrumentation
        android:name="com.kimjisub.launchpad.ProcessRecoveryDriver"
        android:targetPackage="com.kimjisub.launchpad.dev.test" />
</manifest>
