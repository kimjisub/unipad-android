<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Debug installs send no analytics, performance or crash reports to Firebase, from the very first
        launch. The SDKs read these values while their content providers start, before
        BaseApplication.onCreate(), so turning collection off in code would be too late.
        A crash collection value saved earlier through the Crashlytics API overrides the one here:
        clear the app's data before a run that must not report.
    -->
    <!--
        Lets a debug build made with -PdownloadAccountingEmulator, and the device tests run with
        downloadAccountingBackend=demo-unipad, reach the local Firebase emulators at 10.0.2.2 on
        Android 17, which blocks local network addresses without it. Nothing requests it at run time;
        grant it with `adb shell pm grant <package> android.permission.ACCESS_LOCAL_NETWORK`.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <application>
        <!-- false only in a build made for an analytics server check, see UsageEventRouting. -->
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="${analyticsCollectionDeactivated}" />
        <meta-data android:name="firebase_performance_collection_deactivated" android:value="true" />
        <!-- true only in a build made for a crash report check (-PcrashReportCheck), see NativeCrashCheckReceiver. -->
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="${crashlyticsCollectionEnabled}" />
        <receiver
            android:name=".tool.NativeCrashCheckReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <provider
            android:name=".tool.ProcessRecoveryProbe"
            android:authorities="${applicationId}.process-recovery-probe"
            android:enabled="false"
            android:exported="false" />
    </application>
</manifest>
