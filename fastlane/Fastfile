# UniPad Android — Play Store deploy lanes.
# Secrets (keystore, Play service-account JSON) are injected by the store-deploy skill's
# op-bootstrap.sh at runtime; nothing sensitive lives in this file.
#
# Release signing itself is already wired in app/build.gradle via keystore.properties,
# so a local `gradle bundleRelease` signs with the real upload key without extra config.

default_platform(:android)

BUILD_GRADLE = File.expand_path("../app/build.gradle", __dir__)

# Reads the current versionCode from app/build.gradle.
def current_version_code
  File.read(BUILD_GRADLE).match(/versionCode\s*=\s*(\d+)/)[1].to_i
end

# Reads versionName from app/build.gradle. supply otherwise names the Play release after
# whatever it finds first, which showed "4.1.3" for the 4.1.4 upload.
def current_version_name
  File.read(BUILD_GRADLE).match(/versionName\s*=\s*"([^"]+)"/)[1]
end

# Highest versionCode Play already knows about, across every track. The local
# build.gradle can lag behind (a build made elsewhere, a manual upload), and Play
# rejects an AAB whose versionCode is not strictly greater than the last upload.
def highest_play_version_code
  %w[internal alpha beta production].flat_map { |t|
    begin
      google_play_track_version_codes(track: t)
    rescue StandardError
      [] # track may not exist yet
    end
  }.map(&:to_i).max || 0
end

# Sets versionCode to one past whichever is higher: the local value or Play's.
def bump_version_code!
  contents = File.read(BUILD_GRADLE)
  local = current_version_code
  remote = highest_play_version_code
  next_code = [local, remote].max + 1
  File.write(BUILD_GRADLE, contents.sub(/versionCode\s*=\s*\d+/, "versionCode = #{next_code}"))
  UI.success("versionCode -> #{next_code} (local was #{local}, Play had #{remote})")
  next_code
end

# Read and update a production release in one edit, preserving every other field.
def update_production_release(version_code)
  UI.user_error!("PLAY_JSON_KEY_FILE not set — run op-bootstrap.sh android first") if ENV["PLAY_JSON_KEY_FILE"].to_s.empty?
  require "supply"
  require "supply/options"

  Supply.config = FastlaneCore::Configuration.create(
    Supply::Options.available_options,
    json_key: ENV["PLAY_JSON_KEY_FILE"], track: "production",
  )
  client = Supply::Client.make_from_config
  begin
    client.begin_edit(package_name: Supply.config[:package_name])
    track = client.get_edit_track("production")
    release = track&.releases&.find { |item| Array(item.version_codes).map(&:to_s).include?(version_code) }
    UI.user_error!("Production release #{version_code} not found") unless release
    yield release, track
    client.update_track("production", track)
    begin
      client.commit_current_edit!
    rescue StandardError => error
      raise error, "#{error.message}. The change may already have been applied to Play. Re-read the production track before retrying."
    end
  ensure
    if client.current_edit
      begin
        client.abort_current_edit
      rescue StandardError => error
        UI.important("Unable to discard the Play edit: #{error.message}")
      end
    end
  end
end

def staged_rollout_fraction(release, version_code)
  fraction = release.user_fraction
  UI.user_error!("Production release #{version_code} has no valid staged rollout fraction") unless fraction && fraction.finite? && fraction > 0 && fraction < 1
  fraction
end

# Accept decimal fractions only; whole-number percentages would release to everyone.
def rollout_fraction(value)
  fraction = begin
    Float(value.to_s)
  rescue ArgumentError, TypeError
    nil
  end
  UI.user_error!("Pass fraction as a decimal between 0 and 1 (e.g. 0.5 = 50%, 1 = complete), got #{value.inspect}") unless fraction && fraction > 0 && fraction <= 1
  fraction
end

platform :android do
  desc "Build a signed release AAB without uploading (build/sign verification)."
  lane :build_only do
    gradle(task: "clean")
    gradle(task: "bundle", build_type: "Release")
    UI.success("AAB: #{lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]}")
  end

  desc "Build a signed AAB and upload to the given Play track. Pass track:internal|alpha|beta|production."
  lane :deploy do |options|
    track = options[:track] || "internal"
    rollout = rollout_fraction(options[:rollout]) if track == "production" || options.key?(:rollout)
    UI.user_error!("Pass rollout only for the production track") if track != "production" && options.key?(:rollout)
    status = track == "production" ? (rollout == 1 ? "completed" : "inProgress") : "draft"
    UI.user_error!("PLAY_JSON_KEY_FILE not set — run op-bootstrap.sh android first") if ENV["PLAY_JSON_KEY_FILE"].to_s.empty?

    bump_version_code! unless options[:no_bump]
    gradle(task: "clean")
    gradle(task: "bundle", build_type: "Release")
    # Crashlytics names native crash frames only with these symbols; bundleRelease does not send them.
    gradle(task: "uploadCrashlyticsSymbolFile", build_type: "Release")

    # Production requires an explicit rollout: 0.1 stages to 10%, 1 completes.
    upload_to_play_store(
      track: track,
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      # Without the R8 mapping, Play shows obfuscated frames ("Exception w30") and
      # cannot group crashes properly. gradle exposes the path after bundleRelease.
      mapping: lane_context[SharedValues::GRADLE_MAPPING_TXT_OUTPUT_PATH],
      version_name: current_version_name,
      release_status: status,
      rollout: rollout&.to_s,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
    UI.success("Uploaded versionCode #{current_version_code} to Play track '#{track}' (#{status}#{rollout ? ", rollout #{rollout}" : ""}).")
  end

  desc "Promote an already-uploaded build (e.g. from internal) into production as a staged release. Pass version_code:NNN and fraction:0.1 (1 = everyone)."
  lane :promote do |options|
    fraction = rollout_fraction(options.fetch(:fraction, 0.1))
    UI.user_error!("PLAY_JSON_KEY_FILE not set — run op-bootstrap.sh android first") if ENV["PLAY_JSON_KEY_FILE"].to_s.empty?
    from = options[:from] || "internal"
    # `rollout` below only adjusts a release that is already on production; a build that
    # lives on internal has to be promoted first, which is a different supply call.
    upload_to_play_store(
      track: from,
      track_promote_to: "production",
      track_promote_release_status: fraction == 1 ? "completed" : "inProgress",
      version_code: options[:version_code] || current_version_code,
      version_name: options[:version_name] || current_version_name,
      rollout: fraction.to_s,
      skip_upload_aab: true, skip_upload_apk: true, skip_upload_metadata: true,
      skip_upload_images: true, skip_upload_screenshots: true, skip_upload_changelogs: true,
    )
    UI.success("promoted #{options[:version_code] || current_version_code} from #{from} to production at #{fraction}")
  end

  desc "Widen or resume a staged production rollout. Pass fraction:0.5 (1 = complete) and version_code:NNN."
  lane :rollout do |options|
    fraction = rollout_fraction(options[:fraction])
    version_code = (options[:version_code] || current_version_code).to_s
    update_production_release(version_code) do |release, track|
      UI.user_error!("Production release #{version_code} must be inProgress or halted to widen or resume (was #{release.status})") unless %w[inProgress halted].include?(release.status)
      current_fraction = staged_rollout_fraction(release, version_code)
      UI.user_error!("Requested fraction #{fraction} is lower than the current fraction #{current_fraction}") if fraction < current_fraction
      if fraction == 1
        # Play allows one release per status on a track, so the new full release replaces the old one.
        track.releases = track.releases.reject { |item| !item.equal?(release) && item.status == "completed" }
        release.status = "completed"
        release.user_fraction = nil
      else
        release.status = "inProgress"
        release.user_fraction = fraction
      end
    end
    UI.success("production rollout #{version_code} -> #{fraction == 1 ? "completed" : fraction}")
  end

  desc "Halt the current staged production rollout (keeps the release, stops new users getting it)."
  lane :halt do |options|
    version_code = (options[:version_code] || current_version_code).to_s
    fraction = nil
    update_production_release(version_code) do |release|
      UI.user_error!("Production release #{version_code} is completed; a 100% rollout cannot be halted") if release.status == "completed"
      UI.user_error!("Production release #{version_code} must be inProgress to halt (was #{release.status})") unless release.status == "inProgress"
      fraction = staged_rollout_fraction(release, version_code)
      release.status = "halted"
    end
    UI.success("production rollout #{version_code} halted at #{fraction}")
  end
end
